{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated user profile in Kora",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "role": { "type": "string", "enum": ["Owner", "Manager", "Cashier", "Stock Manager", "Employee"] },
        "businessId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "name", "email", "role"]
    },
    "BusinessProfile": {
      "title": "BusinessProfile",
      "description": "Small business entity managed in Kora",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "maxLength": 50 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "currency": { "type": "string", "maxLength": 10 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "type", "currency", "ownerUid"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory product item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "sku": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "maxLength": 50 },
        "purchasePrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "currentStock": { "type": "number" },
        "minStock": { "type": "number" },
        "supplier": { "type": "string", "maxLength": 100 },
        "businessId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "purchasePrice", "sellingPrice", "currentStock", "businessId"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Recorded customer sales transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "receiptNumber": { "type": "string", "maxLength": 50 },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "amountPaid": { "type": "number" },
        "outstandingDebt": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 30 },
        "paymentStatus": { "type": "string", "enum": ["Paid", "Partially Paid", "Unpaid"] },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 50 },
        "estimatedGrossProfit": { "type": "number" },
        "businessId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "receiptNumber", "totalAmount", "amountPaid", "paymentStatus", "date", "businessId"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Recorded operational expense",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "category": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 200 },
        "paymentMethod": { "type": "string", "maxLength": 30 },
        "date": { "type": "string", "maxLength": 50 },
        "businessId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "amount", "category", "date", "businessId"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Client profile and credit record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 40 },
        "totalPurchases": { "type": "number" },
        "amountPaid": { "type": "number" },
        "outstandingDebt": { "type": "number" },
        "notes": { "type": "string", "maxLength": 300 },
        "businessId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "name", "businessId"]
    },
    "CustomerPayment": {
      "title": "CustomerPayment",
      "description": "Debt payoff transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 30 },
        "date": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 200 },
        "businessId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "customerId", "amount", "date", "businessId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection"
    },
    "/businesses/{businessId}": {
      "schema": "BusinessProfile",
      "description": "Business profile store"
    },
    "/businesses/{businessId}/products/{productId}": {
      "schema": "Product",
      "description": "Products under business"
    },
    "/businesses/{businessId}/sales/{saleId}": {
      "schema": "Sale",
      "description": "Sales records under business"
    },
    "/businesses/{businessId}/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Expenses under business"
    },
    "/businesses/{businessId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer debt and profiles under business"
    },
    "/businesses/{businessId}/payments/{paymentId}": {
      "schema": "CustomerPayment",
      "description": "Debt payments under business"
    }
  }
}
